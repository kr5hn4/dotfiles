# ─────────────────────────────────────────────
# appearance.conf
# vim: set filetype=conf :
# GENERATED BY MATUGEN. DO NOT EDIT THIS FILE.
# Source: ~/.config/matugen/templates/mango.conf
# ─────────────────────────────────────────────

# Gaps
gap_inner_horizontal=6
gap_inner_vertical=6
gap_outer_horizontal=10
gap_outer_vertical=10
smart_gaps=0

# Scratchpad
scratchpad_width_ratio=0.8
scratchpad_height_ratio=0.9

# Borders
border_px=2
no_border_when_single=0

# Colors
# Material Design 3 color roles

root_color=0x{{colors.surface.dark.hex_stripped}}ff
border_color=0x{{colors.outline_variant.dark.hex_stripped}}ff
focus_color=0x{{colors.primary.dark.hex_stripped}}ff
maximized_screen_color=0x{{colors.tertiary.dark.hex_stripped}}ff
urgent_color=0x{{colors.error.dark.hex_stripped}}ff
scratchpad_color=0x{{colors.secondary.dark.hex_stripped}}ff
global_color=0x{{colors.primary_container.dark.hex_stripped}}ff
overlay_color=0x{{colors.secondary_container.dark.hex_stripped}}ff

# Behavior
axis_bind_apply_timeout=100
focus_on_activate=1
idle_inhibit_ignore_visible=0
sloppy_focus=0
warp_cursor=1
focus_cross_monitor=0
focus_cross_tag=0
enable_floating_snap=1
snap_distance=20
drag_tile_to_tile=1

# Cursor
cursor_size=32
cursor_theme=Gruvbox

# ─────────────────────────────────────────────
# Effects
# Philosophy: depth through light and blur, not decoration.
# ─────────────────────────────────────────────

# Blur
blur=1
blur_layer=1
blur_optimized=1
blur_params_num_passes=3
blur_params_radius=6
blur_params_noise=0.015
blur_params_brightness=0.95
blur_params_contrast=0.95
blur_params_saturation=1.15

# Shadows
shadows=1
layer_shadows=1
shadow_only_floating=1
shadows_size=16
shadows_blur=24
shadows_position_x=0
shadows_position_y=6
shadows_color=0x00000066

# Corners
border_radius=14
no_radius_when_single=0

# Opacity
focused_opacity=1.0
unfocused_opacity=0.94
